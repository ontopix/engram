            "operation": "write_text",
            "path": ".engram/schemas/fixed.md",
            "source": "testdata/conformance/files/immutable-schema.md"
          },
          {
            "operation": "write_text",
            "path": "fixed.md",
            "source": "testdata/conformance/files/immutable-record.md"
          }
        ]
      },
      "candidate": {
        "operations": [
          {
            "operation": "write_text",
            "path": ".engram/schemas/fixed.md",
            "source": "testdata/conformance/files/immutable-schema.md"
          }
        ]
      },
      "expected": {
        "status": "complete",
        "findings": [
          {"code": "E501", "path": "fixed.md"}
        ]
      }
    },
