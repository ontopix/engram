{
  "version": 1,
  "seed": "examples/minimal",
  "common": [
    {
      "operation": "write_text",
      "path": "README.md",
      "source": "testdata/conformance/files/root-catalog-none.md"
    }
  ],
  "cases": [
    {
      "id": "yaml-core-plain-date",
      "description": "A plain YAML date scalar resolves to a string and satisfies asserted date format validation.",
      "kind": "snapshot",
      "snapshot": {
        "operations": [
          {
            "operation": "write_text",
            "path": ".engram/schemas/dated-event.md",
            "source": "testdata/conformance/files/date-schema.md"
          },
          {
            "operation": "write_text",
            "path": "dated-event.md",
            "source": "testdata/conformance/files/date-record.md"
          }
        ]
      },
      "expected": {
        "findings": []
      }
    },
    {
      "id": "normed-text-encoding",
      "description": "UTF-8 BOM, CRLF, and UTF-16 each produce E108 without dependent parse findings.",
      "kind": "snapshot",
      "snapshot": {
        "operations": [
          {
            "operation": "write_base64",
            "path": ".engram/root.yaml",
            "content": "77u/ZW5ncmFtOiAxCg=="
          },
          {
            "operation": "write_base64",
            "path": "crlf.md",
            "content": "LS0tDQp0eXBlOiBub3RlDQpkZXNjcmlwdGlvbjogIkNSTEYgcmVjb3JkLiINCi0tLQ0KIyBDUkxGDQo="
          },
          {
            "operation": "write_base64",
            "path": "utf16.md",
            "content": "//4tAC0ALQAKAHQAeQBwAGUAOgAgAG4AbwB0AGUACgBkAGUAcwBjAHIAaQBwAHQAaQBvAG4AOgAgACIAVQBUAEYALQAxADYAIAByAGUAYwBvAHIAZAAuACIACgAtAC0ALQAKACMAIABVAFQARgAtADEANgAKAA=="
          }
        ]
      },
      "expected": {
        "findings": [
          {"code": "E108", "path": ".engram/root.yaml"},
          {"code": "E108", "path": "crlf.md"},
          {"code": "E108", "path": "utf16.md"}
        ]
      }
    },
    {
